{
  "framework": null,
  "installCommand": "npm install -w packages/studio --include-workspace-root --ignore-scripts",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/cf-image",
      "destination": "/api/cf-image"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.muapi.ai/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
